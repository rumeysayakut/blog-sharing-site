@model RumyBlog.API.DTOs.PostUpdateDto

@{
    ViewData["Title"] = "Blog Güncelle";
    Layout = "_Layout";
}

<h2 class="page-title">✏️ Blog Güncelle</h2>

<form asp-action="Edit"
      asp-controller="PostsMvc"
      method="post"
      enctype="multipart/form-data"
      class="post-form">

    <!-- ID -->
    <input type="hidden" name="Id" value="@Model.Id" />

    <div class="form-group">
        <label>Başlık</label>
        <input type="text"
               name="Title"
               value="@Model.Title"
               required />
    </div>

    <div class="form-group">
        <label>İçerik</label>
        <textarea name="Content"
                  rows="14"
                  required>@Model.Content</textarea>
    </div>

   

    <button type="submit" class="btn-update">💾 Güncelle</button>
</form>
